# Örnek istekler — VS Code "REST Client" eklentisi (humao.rest-client):
# her isteğin üstündeki "Send Request"e tıkla. Önce sunucu: npm run dev
#
# Token'lar login isteklerinden otomatik alınıyor; önce iki login'i bir kez
# gönder.

@api = http://localhost:3000/api

### Sağlık kontrolü
GET {{api}}/health

### İşveren girişi
# @name employer
POST {{api}}/auth/login
Content-Type: application/json

{ "role": "employer" }

### İş arayan girişi
# @name worker
POST {{api}}/auth/login
Content-Type: application/json

{ "role": "worker" }

### Geçersiz rol → 400 INVALID_ROLE
POST {{api}}/auth/login
Content-Type: application/json

{ "role": "admin" }

### Adaylar (tümü, önerilen sıra)
GET {{api}}/candidates
Authorization: Bearer {{employer.response.body.data.token}}

### Adaylar: %100 eşleşme, en yakın
GET {{api}}/candidates?tab=perfect&sort=near
Authorization: Bearer {{employer.response.body.data.token}}

### Adaylar: benzer, puana göre
GET {{api}}/candidates?tab=similar&sort=rating
Authorization: Bearer {{employer.response.body.data.token}}

### Geçersiz sıralama → 400 INVALID_QUERY
GET {{api}}/candidates?sort=fiyat
Authorization: Bearer {{employer.response.body.data.token}}

### Yanlış rol → 401 FORBIDDEN_ROLE
GET {{api}}/candidates
Authorization: Bearer {{worker.response.body.data.token}}

### Token yok → 401 UNAUTHORIZED
GET {{api}}/candidates

### Aday fotoğrafı (token gerekmez)
GET http://localhost:3000/assets/photos/merve.png

### Görüşme talebi gönder: Merve + Derya → 201
# İkinci kez gönderirsen 409 alırsın (bekleyen talep var).
POST {{api}}/offers
Authorization: Bearer {{employer.response.body.data.token}}
Content-Type: application/json

{ "workerIds": ["w_merve", "w_derya"] }

### Boş seçim → 400 EMPTY_SELECTION
POST {{api}}/offers
Authorization: Bearer {{employer.response.body.data.token}}
Content-Type: application/json

{ "workerIds": [] }

### Bilinmeyen aday → 404 UNKNOWN_WORKER (Ayşe'ye de yazılmaz)
POST {{api}}/offers
Authorization: Bearer {{employer.response.body.data.token}}
Content-Type: application/json

{ "workerIds": ["w_ayse", "w_yok"] }

### ─── İŞ ARAYAN ───────────────────────────────────────────────

### Bekleyen talepler (kalan süre sunucuda hesaplanır)
GET {{api}}/offers?status=pending
Authorization: Bearer {{worker.response.body.data.token}}

### Cevaplanan talepler (kabul + red)
GET {{api}}/offers?status=answered
Authorization: Bearer {{worker.response.body.data.token}}

### Süresi dolan talepler
GET {{api}}/offers?status=expired
Authorization: Bearer {{worker.response.body.data.token}}

### Detay: Barista (şehir + not eklenir)
GET {{api}}/offers/o_barista
Authorization: Bearer {{worker.response.body.data.token}}

### İlgileniyorum: Garson → accepted (ikinci kez → 409 OFFER_STATE)
POST {{api}}/offers/o_garson/accept
Authorization: Bearer {{worker.response.body.data.token}}

### İlgilenmiyorum: Barista → rejected
POST {{api}}/offers/o_barista/reject
Authorization: Bearer {{worker.response.body.data.token}}

### ─── DEMO YARDIMCILARI (token gerekmez) ─────────────────────

### Komi'nin süresini hemen doldur → "Süresi Dolan" sekmesine geçer
# Sonra "İlgileniyorum" denersen: 409 "Teklifin süresi doldu."
POST {{api}}/dev/expire/o_komi

### Her şeyi başa döndür (seed)
POST {{api}}/dev/reset
